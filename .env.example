# Database
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Auth
JWT_SECRET="super-secret-key-change-this"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="refresh-token-secret-change-this"
JWT_REFRESH_EXPIRATION="7d"

# App
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"

# Gemini AI
GEMINI_API_KEY="your-gemini-api-key-here"

# Stripe
STRIPE_SECRET_KEY="your-stripe-secret-key-here"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret-here"

# LinkedIn
LINKEDIN_CLIENT_ID="your-linkedin-client-id-here"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret-here"
LINKEDIN_REDIRECT_URI="http://localhost:3000/linkedin/callback"

# PayTech
PAYTECH_API_KEY="your-paytech-api-key-here"
PAYTECH_API_SECRET="your-paytech-api-secret-here"
PAYTECH_ENV="test"

# Redis
REDIS_URL="redis://localhost:6379"

# Mail (SMTP)
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USER="your-mailtrap-user"
MAIL_PASS="your-mailtrap-pass"
MAIL_FROM="noreply@postcraft.ai"

# Google Auth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# GitHub Auth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"

# Facebook Auth
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
FACEBOOK_CALLBACK_URL="http://localhost:3000/auth/facebook/callback"
